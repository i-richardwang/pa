# 语义物理数据目录（版本化 parquet）
PA_SEMANTIC_DATA_DIR=./data/semantic_data

# 版本化语义包：包含 semantic_package.yml 与 Cube model/；其他部署可指向外部包目录。
# 本地省略时默认使用仓库内 ./demo，Docker Compose 也采用同一默认值。
PA_SEMANTIC_PACKAGE_DIR=./demo

# Cube REST API 的 JWT 签名密钥（生成：openssl rand -hex 32）
CUBEJS_API_SECRET=change-me

# 端口与暴露范围：Cube 与 MCP 默认只绑本机；明确需要局域网接入时再改宿主监听地址。
PA_CUBE_PORT=4000
PA_SERVER_BIND_IP=127.0.0.1
PA_SERVER_PORT=8788
# 直接运行服务时默认监听 127.0.0.1；Docker Compose 会在容器内显式监听 0.0.0.0，
# 宿主侧范围仍由 PA_SERVER_BIND_IP 决定。

# 鉴权基座（Better Auth）：设置即启用 /mcp 的两条接入通道——连接器走 OAuth，
# 自动化脚本走用户自助签发的 API key（均绑定同一套用户身份）。生成：openssl rand -hex 32。
# 留空时服务默认拒绝启动；设 PA_ALLOW_OPEN=1 表示明确接受当前可达范围内无鉴权，
# 此时所有调用者均按全量管理员身份执行，仅限本机临时体验。
# 用户开通：cd server && bun run user:create -- <email> <password> [显示名]
# 签发 API key（无浏览器/CI 场景）：cd server && bun run key:issue -- <email> [名称]，
#   或登录 /dashboard 的「我的 API Key」自助创建
PA_AUTH_SECRET=
PA_ALLOW_OPEN=
# OAuth issuer、登录回跳与下载链接基址，必须是消费端和用户浏览器能访问的地址。
# 非本机部署应使用消费端和用户浏览器可达的 HTTPS 地址。
PA_BASE_URL=http://127.0.0.1:8788
# 浏览器来源默认只允许 loopback；其他受信来源在此补充（逗号分隔）。
PA_ALLOWED_ORIGINS=

# 本地验收脚本用（非服务运行时）
# MCP 客户端鉴权：bun run smoke 携带的 Bearer token，由 bun run key:issue 签发。
PA_MCP_API_KEY=
# OAuth 全流程冒烟（bun run smoke:oauth）登录用的测试账号邮箱。
PA_OAUTH_EMAIL=
# OAuth 全流程冒烟（bun run smoke:oauth）登录用的测试账号密码。
PA_OAUTH_PASSWORD=
# 受限权限回归：测试账号配置单一 access_scope 时，在此声明期望值，供 smoke:oauth 校验派生查询与重放。
PA_EXPECT_ACCESS_SCOPE_VALUE=
