{
  "name": "pa-server",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "type": "module",
  "description": "PA (People Analytics Service) 应用服务：分析、呈现、报告与导出，经 MCP 工具面与控制台交付，包 Cube REST API",
  "workspaces": [
    "result_view",
    "widget",
    "console"
  ],
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "clean": "bun scripts/clean_build.ts",
    "build": "bun run clean && tsc && bun run build:widget && bun run build:console",
    "build:widget": "vite build widget",
    "build:console": "vite build console && vite build console --mode dashboard",
    "start": "node dist/index.js",
    "test": "bun test",
    "eval:formal": "bun --env-file=../.env scripts/formal_metric_smoke.ts",
    "eval:time": "bun --env-file=../.env scripts/time_eval.ts",
    "eval:access": "bun --env-file=../.env scripts/access_policy_smoke.ts",
    "eval:records": "bun --env-file=../.env scripts/record_projection_smoke.ts",
    "smoke": "bun scripts/smoke.ts",
    "smoke:oauth": "bun scripts/oauth_smoke.ts",
    "seed:demo": "docker compose -f ../docker-compose.yml --profile tools run --rm --build seed",
    "generate:data-capability-map": "bun scripts/generate_data_capability_map.ts",
    "user:create": "bun scripts/create_user.ts",
    "key:issue": "bun scripts/issue_key.ts",
    "format": "biome format --write . && uvx ruff==0.15.22 format --config ../ruff.toml ..",
    "format:check": "biome format . && uvx ruff==0.15.22 format --check --config ../ruff.toml ..",
    "lint:ts": "biome lint --error-on-warnings .",
    "lint:python": "uvx ruff==0.15.22 check --config ../ruff.toml ..",
    "lint:shell": "uvx --from shellcheck-py==0.11.0.1 shellcheck ../.githooks/pre-commit",
    "lint": "bun run lint:ts && bun run lint:python && bun run lint:shell",
    "typecheck": "bun scripts/typecheck.ts",
    "typecheck:tests": "bun scripts/typecheck.ts --tests",
    "test:python": "bun scripts/test_python.ts",
    "audit:dependencies": "bun audit",
    "check:open-source": "uv run ../scripts/check_open_source_boundary.py",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run typecheck:tests && bun test && bun run test:python && bun run build && bun run check:open-source"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.27",
    "@better-auth/cimd": "1.7.27",
    "@better-auth/mcp": "1.7.27",
    "@better-auth/oauth-provider": "1.7.27",
    "@fontsource-variable/inter": "5.3.0",
    "@hono/node-server": "2.1.11",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "2.4.0",
    "better-auth": "1.7.27",
    "hono": "4.13.21",
    "jose": "6.2.18",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@tailwindcss/node": "4.3.2",
    "@tailwindcss/vite": "4.3.2",
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.3"
  }
}
